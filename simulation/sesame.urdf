<?xml version="1.0" encoding="utf-8"?>
<robot name="sesame">

  <!-- Color Definitions -->
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.3 0.7 0.3 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- Base Link (Trunk) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.130"/>
      <inertia ixx="5.29e-5" ixy="0" ixz="0" iyy="7.21e-5" iyz="0" izz="1.19e-4"/>
    </inertial>
    
    <!-- White Bottom Chassis -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.068 0.016"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.068 0.016"/>
      </geometry>
    </collision>

    <!-- Green Top Cover -->
    <visual>
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.068 0.012"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- Ultrasonic eyes -->
    <visual>
      <origin xyz="0.043 -0.012 0.014" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.005"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="0.043 0.012 0.014" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.006" radius="0.005"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- Corner Servos -->
    <visual>
      <origin xyz="0.035 -0.030 -0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.035 -0.030 -0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="0.035 0.030 -0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.035 0.030 -0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.022 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <!-- ==================== FRONT RIGHT LEG ==================== -->
  <!-- Hip Joint (Yaw) -->
  <joint name="front_right_hip" type="revolute">
    <origin xyz="0.035 -0.030 -0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_femur"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="1.5708" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Femur (Upper Leg) -->
  <link name="front_right_femur">
    <inertial>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="2.56e-6" ixy="0" ixz="0" iyy="2.56e-6" iyz="0" izz="2.0e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
      <material name="green"/>
    </visual>
    <visual>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.016 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
    </collision>
  </link>

  <!-- Knee Joint (Pitch) -->
  <joint name="front_right_knee" type="revolute">
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
    <parent link="front_right_femur"/>
    <child link="front_right_tibia"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.3562" upper="0.0" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Tibia (Lower Leg) -->
  <link name="front_right_tibia">
    <inertial>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.26e-6" ixy="0" ixz="0" iyy="1.26e-6" iyz="0" izz="5.0e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== BACK RIGHT LEG ==================== -->
  <!-- Hip Joint (Yaw) -->
  <joint name="back_right_hip" type="revolute">
    <origin xyz="-0.035 -0.030 -0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_right_femur"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="0.7854" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Femur (Upper Leg) -->
  <link name="back_right_femur">
    <inertial>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="2.56e-6" ixy="0" ixz="0" iyy="2.56e-6" iyz="0" izz="2.0e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
      <material name="green"/>
    </visual>
    <visual>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.016 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
    </collision>
  </link>

  <!-- Knee Joint (Pitch) -->
  <joint name="back_right_knee" type="revolute">
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
    <parent link="back_right_femur"/>
    <child link="back_right_tibia"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.3562" upper="0.0" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Tibia (Lower Leg) -->
  <link name="back_right_tibia">
    <inertial>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.26e-6" ixy="0" ixz="0" iyy="1.26e-6" iyz="0" izz="5.0e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FRONT LEFT LEG ==================== -->
  <!-- Hip Joint (Yaw) -->
  <joint name="front_left_hip" type="revolute">
    <origin xyz="0.035 0.030 -0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_femur"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.7854" upper="1.5708" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Femur (Upper Leg) -->
  <link name="front_left_femur">
    <inertial>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="2.56e-6" ixy="0" ixz="0" iyy="2.56e-6" iyz="0" izz="2.0e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
      <material name="green"/>
    </visual>
    <visual>
      <origin xyz="0 0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.016 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
    </collision>
  </link>

  <!-- Knee Joint (Pitch) -->
  <joint name="front_left_knee" type="revolute">
    <origin xyz="0 0.025 0" rpy="0 0 0"/>
    <parent link="front_left_femur"/>
    <child link="front_left_tibia"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-2.3562" upper="0.0" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Tibia (Lower Leg) -->
  <link name="front_left_tibia">
    <inertial>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.26e-6" ixy="0" ixz="0" iyy="1.26e-6" iyz="0" izz="5.0e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== BACK LEFT LEG ==================== -->
  <!-- Hip Joint (Yaw) -->
  <joint name="back_left_hip" type="revolute">
    <origin xyz="-0.035 0.030 -0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_left_femur"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="0.7854" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Femur (Upper Leg) -->
  <link name="back_left_femur">
    <inertial>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="2.56e-6" ixy="0" ixz="0" iyy="2.56e-6" iyz="0" izz="2.0e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
      <material name="green"/>
    </visual>
    <visual>
      <origin xyz="0 0.015 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.016 0.020"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.025 0.016"/>
      </geometry>
    </collision>
  </link>

  <!-- Knee Joint (Pitch) -->
  <joint name="back_left_knee" type="revolute">
    <origin xyz="0 0.025 0" rpy="0 0 0"/>
    <parent link="back_left_femur"/>
    <child link="back_left_tibia"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-2.3562" upper="0.0" effort="1.0" velocity="10.0"/>
  </joint>

  <!-- Tibia (Lower Leg) -->
  <link name="back_left_tibia">
    <inertial>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.26e-6" ixy="0" ixz="0" iyy="1.26e-6" iyz="0" izz="5.0e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.040"/>
      </geometry>
    </collision>
  </link>

</robot>
