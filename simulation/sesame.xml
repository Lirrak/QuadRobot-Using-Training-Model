<mujoco model="sesame">
  <compiler angle="radian" coordinate="local" balanceinertia="true"/>
  
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <!-- Visual assets/materials -->
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.2"/>
    <material name="body_mat" rgba="0.9 0.9 0.9 1.0"/> <!-- White bottom cover/chassis -->
    <material name="cover_mat" rgba="0.3 0.7 0.3 1.0"/> <!-- Green top cover & femur -->
    <material name="servo_mat" rgba="0.15 0.15 0.15 1.0"/> <!-- Black servos/eyes -->
    <material name="tibia_mat" rgba="0.9 0.9 0.9 1.0"/> <!-- White tibia legs -->
  </asset>

  <worldbody>
    <!-- Ground Plane -->
    <geom name="floor" type="plane" size="0 0 .25" pos="0 0 0" material="grid_mat" condim="3" friction="1.0 0.005 0.0001"/>
    
    <!-- Sun/Light -->
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>

    <!-- Robot Base Link (Trunk) -->
    <!-- Initialized slightly off the ground -->
    <body name="base_link" pos="0 0 0.08">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.130" diaginertia="5.29e-5 7.21e-5 1.19e-4"/>
      
      <!-- Visual and collision body -->
      <geom type="box" size="0.040 0.034 0.008" material="body_mat" condim="3"/>
      <!-- Green Top Cover -->
      <geom type="box" size="0.040 0.034 0.006" pos="0 0 0.014" material="cover_mat"/>
      
      <!-- Ultrasonic sensor "eyes" -->
      <geom type="cylinder" fromto="0.040 -0.012 0.014 0.046 -0.012 0.014" size="0.005" material="servo_mat"/>
      <geom type="cylinder" fromto="0.040 0.012 0.014 0.046 0.012 0.014" size="0.005" material="servo_mat"/>

      <!-- Hip Yaw Servos inside chassis corners -->
      <geom type="box" size="0.011 0.011 0.010" pos="0.035 -0.030 -0.006" material="servo_mat"/>
      <geom type="box" size="0.011 0.011 0.010" pos="-0.035 -0.030 -0.006" material="servo_mat"/>
      <geom type="box" size="0.011 0.011 0.010" pos="0.035 0.030 -0.006" material="servo_mat"/>
      <geom type="box" size="0.011 0.011 0.010" pos="-0.035 0.030 -0.006" material="servo_mat"/>

      <!-- ==================== FRONT RIGHT LEG ==================== -->
      <body name="front_right_femur" pos="0.035 -0.030 -0.010">
        <joint name="front_right_hip" type="hinge" axis="0 0 1" range="-0.7854 1.5708" damping="0.1" frictionloss="0.02"/>
        <inertial pos="0 -0.0125 0" mass="0.015" diaginertia="2.56e-6 2.56e-6 2.0e-7"/>
        <geom type="box" size="0.008 0.0125 0.008" pos="0 -0.0125 0" material="cover_mat"/>
        <!-- Knee Servo -->
        <geom type="box" size="0.008 0.008 0.010" pos="0 -0.018 0" material="servo_mat"/>
        
        <body name="front_right_tibia" pos="0 -0.025 0">
          <joint name="front_right_knee" type="hinge" axis="1 0 0" range="-1.5708 0.0" damping="0.1" frictionloss="0.02"/>
          <inertial pos="0 0 -0.020" mass="0.005" diaginertia="1.26e-6 1.26e-6 5.0e-8"/>
          <geom type="box" size="0.004 0.004 0.020" pos="0 0 -0.020" material="tibia_mat"/>
          <!-- Foot tip contact sphere -->
          <geom name="front_right_foot" type="sphere" size="0.005" pos="0 0 -0.040" condim="3" friction="1.0 0.005 0.0001" material="tibia_mat"/>
        </body>
      </body>

      <!-- ==================== BACK RIGHT LEG ==================== -->
      <body name="back_right_femur" pos="-0.035 -0.030 -0.010">
        <joint name="back_right_hip" type="hinge" axis="0 0 1" range="-1.5708 0.7854" damping="0.1" frictionloss="0.02"/>
        <inertial pos="0 -0.0125 0" mass="0.015" diaginertia="2.56e-6 2.56e-6 2.0e-7"/>
        <geom type="box" size="0.008 0.0125 0.008" pos="0 -0.0125 0" material="cover_mat"/>
        <!-- Knee Servo -->
        <geom type="box" size="0.008 0.008 0.010" pos="0 -0.018 0" material="servo_mat"/>
        
        <body name="back_right_tibia" pos="0 -0.025 0">
          <joint name="back_right_knee" type="hinge" axis="1 0 0" range="-1.5708 0.0" damping="0.1" frictionloss="0.02"/>
          <inertial pos="0 0 -0.020" mass="0.005" diaginertia="1.26e-6 1.26e-6 5.0e-8"/>
          <geom type="box" size="0.004 0.004 0.020" pos="0 0 -0.020" material="tibia_mat"/>
          <geom name="back_right_foot" type="sphere" size="0.005" pos="0 0 -0.040" condim="3" friction="1.0 0.005 0.0001" material="tibia_mat"/>
        </body>
      </body>

      <!-- ==================== FRONT LEFT LEG ==================== -->
      <body name="front_left_femur" pos="0.035 0.030 -0.010">
        <joint name="front_left_hip" type="hinge" axis="0 0 -1" range="-0.7854 1.5708" damping="0.1" frictionloss="0.02"/>
        <inertial pos="0 0.0125 0" mass="0.015" diaginertia="2.56e-6 2.56e-6 2.0e-7"/>
        <geom type="box" size="0.008 0.0125 0.008" pos="0 0.0125 0" material="cover_mat"/>
        <!-- Knee Servo -->
        <geom type="box" size="0.008 0.008 0.010" pos="0 0.015 0" material="servo_mat"/>
        
        <body name="front_left_tibia" pos="0 0.025 0">
          <joint name="front_left_knee" type="hinge" axis="-1 0 0" range="-1.5708 0.0" damping="0.1" frictionloss="0.02"/>
          <inertial pos="0 0 -0.020" mass="0.005" diaginertia="1.26e-6 1.26e-6 5.0e-8"/>
          <geom type="box" size="0.004 0.004 0.020" pos="0 0 -0.020" material="tibia_mat"/>
          <geom name="front_left_foot" type="sphere" size="0.005" pos="0 0 -0.040" condim="3" friction="1.0 0.005 0.0001" material="tibia_mat"/>
        </body>
      </body>

      <!-- ==================== BACK LEFT LEG ==================== -->
      <body name="back_left_femur" pos="-0.035 0.030 -0.010">
        <joint name="back_left_hip" type="hinge" axis="0 0 -1" range="-1.5708 0.7854" damping="0.1" frictionloss="0.02"/>
        <inertial pos="0 0.0125 0" mass="0.015" diaginertia="2.56e-6 2.56e-6 2.0e-7"/>
        <geom type="box" size="0.008 0.0125 0.008" pos="0 0.0125 0" material="cover_mat"/>
        <!-- Knee Servo -->
        <geom type="box" size="0.008 0.008 0.010" pos="0 0.015 0" material="servo_mat"/>
        
        <body name="back_left_tibia" pos="0 0.025 0">
          <joint name="back_left_knee" type="hinge" axis="-1 0 0" range="-1.5708 0.0" damping="0.1" frictionloss="0.02"/>
          <inertial pos="0 0 -0.020" mass="0.005" diaginertia="1.26e-6 1.26e-6 5.0e-8"/>
          <geom type="box" size="0.004 0.004 0.020" pos="0 0 -0.020" material="tibia_mat"/>
          <geom name="back_left_foot" type="sphere" size="0.005" pos="0 0 -0.040" condim="3" friction="1.0 0.005 0.0001" material="tibia_mat"/>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- Actuators definition mapping to joints with SG90 torque limits (1.6 kg-cm = 0.16 N-m) -->
  <actuator>
    <position name="front_right_hip_act" joint="front_right_hip" kp="3.5" ctrlrange="-0.7854 1.5708" forcerange="-0.16 0.16"/>
    <position name="front_right_knee_act" joint="front_right_knee" kp="3.5" ctrlrange="-1.5708 0.0" forcerange="-0.16 0.16"/>
    <position name="back_right_hip_act" joint="back_right_hip" kp="3.5" ctrlrange="-1.5708 0.7854" forcerange="-0.16 0.16"/>
    <position name="back_right_knee_act" joint="back_right_knee" kp="3.5" ctrlrange="-1.5708 0.0" forcerange="-0.16 0.16"/>
    <position name="front_left_hip_act" joint="front_left_hip" kp="3.5" ctrlrange="-0.7854 1.5708" forcerange="-0.16 0.16"/>
    <position name="front_left_knee_act" joint="front_left_knee" kp="3.5" ctrlrange="-1.5708 0.0" forcerange="-0.16 0.16"/>
    <position name="back_left_hip_act" joint="back_left_hip" kp="3.5" ctrlrange="-1.5708 0.7854" forcerange="-0.16 0.16"/>
    <position name="back_left_knee_act" joint="back_left_knee" kp="3.5" ctrlrange="-1.5708 0.0" forcerange="-0.16 0.16"/>
  </actuator>
</mujoco>
